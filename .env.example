# Copy to .env and adjust. Every value here was exercised against the running
# services on 2026-10-19; a value that has not been exercised does not belong in
# this file.

# Disposable Postgres 16 + pgvector from docker-compose.yml.
DATABASE_URL=postgres://twin:twindevlocal@127.0.0.1:55432/twin

# Local Ollama. No cloud provider is used anywhere in this project.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Verified present on the host: nomic-embed-text emits 768 dimensions, which is
# the width of chunks.embedding.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

LLM_MODEL=mistral-nemo
